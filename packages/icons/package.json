{
  "name": "@intello/substance-icons",
  "version": "1.0.197",
  "description": "Substance Icons is a lightweight React icon library that provides a collection of customizable and scalable SVG icons for modern web applications.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:types && rollup -c rollup.config.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "generate-icons": "node scripts/generateIcons.js",
    "dev": "npm run generate-icons && npm run build",
    "ship": "node scripts/ship.js",
    "deploy": "node scripts/deploy.js",
    "prepack": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "react",
    "icons",
    "svg",
    "components",
    "library",
    "substance-icons",
    "intello",
    "typescript",
    "scalable",
    "customizable",
    "react-icons",
    "lightweight",
    "tree-shakeable"
  ],
  "author": "José Campillo",
  "license": "ISC",
  "homepage": "https://intelloai.com/resources/substance/icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jcampillo1207/substance-icons.git"
  },
  "bugs": {
    "url": "https://github.com/Jcampillo1207/substance-icons/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@svgr/core": "^8.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "fs-extra": "^11.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup": "^4.18.0",
    "svgo": "^3.3.2",
    "tslib": "^2.8.1",
    "typescript": "^5.5.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
